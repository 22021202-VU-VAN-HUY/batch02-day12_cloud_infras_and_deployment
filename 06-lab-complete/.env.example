HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

APP_NAME=Production AI Agent
APP_VERSION=1.0.0

AGENT_API_KEY=replace-with-a-random-secret
